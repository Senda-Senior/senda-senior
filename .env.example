# Configuração pública — obrigatória
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL canônica usada por redirects de autenticação e proteção CSRF (opcional)
NEXT_PUBLIC_SITE_URL=

# Necessária somente se o CAPTCHA/Attack Protection estiver habilitado no Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Configuração exclusiva do servidor — nunca expor ao navegador
SUPABASE_SERVICE_ROLE_KEY=

# Rate limit distribuído (recomendado em produção; opcional em desenvolvimento)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Preview interno da área de assessoria. Manter vazio em produção, salvo allowlist aprovada.
ASSESSORIA_PREVIEW_EMAILS=
ASSESSORIA_PREVIEW_OPEN=
